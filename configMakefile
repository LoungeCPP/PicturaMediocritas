ifeq "$(OS)" "Windows_NT"
	EXE := .exe
	PIC :=
	OS_LD_LIBS :=
else
	EXE :=
	PIC := -fPIC
	OS_LD_LIBS := pthread
endif

ifneq "$(ADDITIONAL_INCLUDE_DIR)" ""
	INCCXXAR := -isystem$(ADDITIONAL_INCLUDE_DIR)
else
	INCCXXAR :=
endif

ifneq "$(ADDITIONAL_LINK_DIR)" ""
	LNCXXAR := -L$(ADDITIONAL_LINK_DIR)
else
	LNCXXAR :=
endif

CXXAR := -g -MD -O3 -fomit-frame-pointer -march=native -std=c++20 -pedantic -Wall -Wextra -Wno-missing-field-initializers -pipe $(INCCXXAR) $(PIC)

OUTDIR := out/
BLDDIR := out/build/
OBJDIR := $(BLDDIR)obj/
SRCDIR := src/
ASSETDIR := assets/
